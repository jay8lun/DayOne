# ============================================================
# 知新 DayOne · 入职手册知识库助手 —— 环境变量样例
# 用法：复制为 .env 后填写（.env 已在 .gitignore 中，不会进仓库）
#   cp .env.example .env
# ============================================================

# ----------------- 应用 -----------------
APP_NAME=知新 DayOne · 入职手册知识库助手
DEBUG=false
HOST=0.0.0.0
PORT=8000
# 前端跨域（同域部署留 * 即可）
CORS_ORIGINS=*
# 服务自身鉴权：留空则不校验；生产建议改成强随机串，前端「设置」里填同一个值
SERVICE_API_KEY=

# ----------------- 大模型（OpenAI 兼容协议） -----------------
# LLM_PROVIDER: auto | openai | mock
#   auto   = 配了 key 就用真模型，没配自动降级为离线抽取式基线（仅联调）
#   openai = 强制走 OpenAI 兼容接口（DeepSeek/通义/智谱/硅基流动/vLLM 都行）
#   mock   = 强制离线基线，不产生任何网络请求
LLM_PROVIDER=auto
LLM_API_KEY=
# 常用三家的 base_url（按需改）：
#   DeepSeek      https://api.deepseek.com/v1          model=deepseek-chat
#   阿里百炼(通义) https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
#   硅基流动       https://api.siliconflow.cn/v1        model=Qwen/Qwen2.5-72B-Instruct
#   智谱          https://open.bigmodel.cn/api/paas/v4  model=glm-4-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=60

# ----------------- Embedding -----------------
# EMBEDDING_PROVIDER: auto | openai | hashing
#   openai  = 走 OpenAI 兼容 /v1/embeddings（推荐，质量远超兜底）
#   hashing = 离线字符 n-gram 哈希（零依赖，演示/单测用，质量较低）
EMBEDDING_PROVIDER=auto
# 留空则复用 LLM_API_KEY / LLM_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 阿里百炼：text-embedding-v3（1024 维）
# 硅基流动：BAAI/bge-m3（1024 维）/ BAAI/bge-large-zh-v1.5（1024 维）
# OpenAI  ：text-embedding-3-small（1536 维，记得同步改 EMBEDDING_DIM）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# 单次请求条数上限：百炼 text-embedding-v3 最多 10；超限会自动折半重试
EMBEDDING_BATCH_SIZE=10
# 离线兜底向量维度（仅 hashing 模式生效）
HASHING_DIM=512

# ----------------- 知识库源（适配器） -----------------
# KB_SOURCE: local_dir | http_json | wecom | 你的插件名
KB_SOURCE=local_dir
# local_dir 用：知识库目录（相对项目根）
KB_LOCAL_PATH=data/corpus
# 启动时若向量库为空，自动入库一次
AUTO_INGEST_ON_STARTUP=true
# 外部适配器插件（逗号分隔的模块路径），换公司时挂自己的插件
ADAPTER_PLUGINS=

# 【换成企业自有知识库接口时，把下面这段打开并填好，KB_SOURCE 改成 http_json】
# KB_ADAPTER_CONFIG={"base_url":"https://kb.corp.example.com/api/v1","list_path":"/documents","detail_path":"/documents/{id}","auth":{"type":"bearer","token":"YOUR_TOKEN"},"items_path":"data.items","next_cursor_path":"data.next_cursor","cursor_param":"cursor","limit_param":"page_size","fields":{"id":"doc_id","title":"name","content":"content.markdown","url":"url","updated_at":"updated_at","author":"creator.name","space":"space.name"},"content_format":"auto"}

# 多源同时挂载（JSON 数组），例如本地兜底 + 远端主库：
# KB_ADAPTER_CONFIG=[{"source":"http_json","base_url":"https://kb.corp/api","list_path":"/docs","detail_path":"/docs/{id}","fields":{"id":"id","title":"title","content":"body"}},{"source":"local_dir","path":"data/corpus"}]

# ----------------- 切块 -----------------
CHUNK_SIZE=520
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=60

# ----------------- 检索 -----------------
RETRIEVE_TOP_K=5
RETRIEVE_CANDIDATES=30
# 是否启用向量通道；hashing 兜底向量会被自动判定为不可信而关闭
ENABLE_DENSE=true
RRF_K=60
# 融合权重：排名融合 vs 词面覆盖度（有向量时 0.6；仅词法时自动提到 0.85）
RRF_WEIGHT=0.6
BM25_K1=1.3
BM25_B=0.85
BM25_TITLE_WEIGHT=5.0
BM25_HEADING_WEIGHT=3.0
ENABLE_MMR=true
MMR_LAMBDA=0.72
# LLM 重排：更准但更贵（每题多一次模型调用），默认关
ENABLE_LLM_RERANK=false
# 查询改写 / 检索纠错
ENABLE_QUERY_REWRITE=true
MAX_CORRECTIVE_ROUNDS=1
# 低于该置信度直接拒答（不会硬编答案）
MIN_CONFIDENCE=0.35
# 拒答第二道闸（满足其一即可）：强词法命中 / 单块词面覆盖度
# 换 embedding 或换语料后要重标（判据：正常问题的最低值 vs 无关问题的最高值）
MIN_BM25_ANCHOR=8.5
MIN_EVIDENCE=0.30

# ----------------- 会话 -----------------
MAX_HISTORY_TURNS=6
SESSION_TTL_MINUTES=120

# ----------------- 存储 -----------------
CHROMA_DIR=data/chroma
COLLECTION_PREFIX=onboarding_kb
INGEST_STATE_FILE=data/ingest_state.json

# ----------------- 评估 -----------------
EVAL_DATASET=app/eval/datasets/golden_onboarding.jsonl
EVAL_TOP_K=5
